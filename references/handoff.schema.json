{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-relay:task-to-task-handoff:1.0",
  "title": "Task-to-Task Handoff Protocol 1.0",
  "oneOf": [
    { "$ref": "#/$defs/handoffReady" },
    { "$ref": "#/$defs/handoffAck" }
  ],
  "$defs": {
    "identity": {
      "type": "object",
      "required": ["agent_id"],
      "properties": {
        "agent_id": { "type": "string", "minLength": 1 },
        "session_id": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["outcomes"],
      "properties": {
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "decisions": { "type": "array", "items": { "type": "string" } },
        "changes": { "type": "array", "items": { "type": "string" } },
        "verification": { "type": "array", "items": { "type": "string" } },
        "risks": { "type": "array", "items": { "type": "string" } },
        "blockers": { "type": "array", "items": { "type": "string" } },
        "next_actions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "workspace": {
      "type": "object",
      "properties": {
        "path": { "type": "string" },
        "repository": { "type": "string" },
        "branch": { "type": "string" },
        "base_sha": { "type": "string" },
        "head_sha": { "type": "string" },
        "dirty": { "type": "boolean" },
        "changed_files": { "type": "array", "items": { "type": "string" } },
        "diff_stat": { "type": "array", "items": { "type": "string" } },
        "truncated": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["type", "location"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 },
        "digest": { "type": "string" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "handoffReady": {
      "type": "object",
      "required": [
        "protocol",
        "version",
        "message_type",
        "handoff_id",
        "created_at",
        "source",
        "task",
        "status",
        "summary"
      ],
      "properties": {
        "protocol": { "const": "task-to-task-handoff" },
        "version": { "const": "1.0" },
        "message_type": { "const": "handoff.ready" },
        "handoff_id": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "source": { "$ref": "#/$defs/identity" },
        "target": { "$ref": "#/$defs/identity" },
        "task": {
          "type": "object",
          "required": ["id", "title"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "status": {
          "enum": ["completed", "partial", "blocked", "failed"]
        },
        "workspace": { "$ref": "#/$defs/workspace" },
        "summary": { "$ref": "#/$defs/summary" },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" }
        },
        "routing": {
          "type": "object",
          "properties": {
            "preferred_transport": { "type": "string" },
            "reply_to": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "handoffAck": {
      "type": "object",
      "required": [
        "protocol",
        "version",
        "message_type",
        "handoff_id",
        "received_at",
        "receiver",
        "disposition"
      ],
      "properties": {
        "protocol": { "const": "task-to-task-handoff" },
        "version": { "const": "1.0" },
        "message_type": { "const": "handoff.ack" },
        "handoff_id": { "type": "string", "minLength": 1 },
        "received_at": { "type": "string", "format": "date-time" },
        "receiver": { "$ref": "#/$defs/identity" },
        "disposition": {
          "enum": ["accepted", "ingested", "needs_changes", "rejected"]
        },
        "verified": { "type": "boolean" },
        "notes": { "type": "array", "items": { "type": "string" } },
        "records": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
